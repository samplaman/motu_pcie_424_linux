<script>
let state = {
  active_bus: 0,
  channels: [],
  dsp: { eq: [] }
};

function showTab(name) {
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-view').forEach(v => v.classList.remove('active'));
  const btn = Array.from(document.querySelectorAll('.nav-btn')).find(b => b.textContent.toLowerCase().includes(name.slice(0,4)));
  if (btn) btn.classList.add('active');
  const view = document.getElementById('view-' + name);
  if (view) view.classList.add('active');
  if (name === 'dsp') renderEQCanvas();
}

function selectBus(idx) {
  state.active_bus = idx;
  document.querySelectorAll('.bus-btn').forEach((b, i) => b.classList.toggle('active', i === idx));
  renderMixer();
}

async function fetchState() {
  try {
    const res = await fetch('/api/mixer');
    state = await res.json();
    renderMixer();
    renderEQCanvas();
    renderPatchbay();
  } catch (e) {
    console.error("Fetch state error:", e);
  }
}

async function fetchStatus() {
  try {
    const res = await fetch('/api/status');
    const d = await res.json();
    document.getElementById('hdr-card-name').textContent = d.model + " • " + (d.driver || "Simulator");
    document.getElementById('clock-status').textContent = (d.clock_locked ? "LOCKED: " : "UNLOCK: ") + (d.sample_rate/1000).toFixed(1) + " kHz";
  } catch (e) {}
}

function renderMixer() {
  const container = document.getElementById('channel-strips-container');
  if (!container || !state.channels) return;
  container.innerHTML = "";

  state.channels.forEach((ch, idx) => {
    const strip = document.createElement('div');
    strip.className = 'channel-strip';
    const isMuted = ch.mute;
    const isSolo = ch.solo;

    strip.innerHTML = `
      <div class="ch-header">${ch.name}</div>
      <div class="ch-sub">${ch.slot} • ${ch.bank}</div>

      <div class="ch-knob-block">
        <span class="knob-val">${ch.trim > 0 ? '+' : ''}${ch.trim} dB</span>
        <span class="knob-lbl">TRIM</span>
      </div>

      <div class="toggles-row">
        <button class="tgl-btn ${ch.pad ? 'active' : ''}" onclick="toggleChParam(${idx}, 'pad')">-20</button>
        <button class="tgl-btn ${ch.phase ? 'active' : ''}" onclick="toggleChParam(${idx}, 'phase')">Ø</button>
        <button class="tgl-btn ${ch.stereo ? 'active' : ''}" onclick="toggleChParam(${idx}, 'stereo')">ST</button>
      </div>

      <div class="ch-knob-block">
        <span class="knob-val">${ch.pan === 0 ? 'C' : (ch.pan < 0 ? 'L' + Math.abs(ch.pan) : 'R' + ch.pan)}</span>
        <span class="knob-lbl">PAN</span>
      </div>

      <div class="mute-solo-row">
        <button class="mute-btn ${isMuted ? 'active' : ''}" onclick="toggleChParam(${idx}, 'mute')">M</button>
        <button class="solo-btn ${isSolo ? 'active' : ''}" onclick="toggleChParam(${idx}, 'solo')">S</button>
      </div>

      <div class="fader-meter-row">
        <canvas class="meter-canvas" id="meter-${idx}" width="14" height="210"></canvas>
        <div class="fader-slot" onmousedown="startFaderDrag(event, ${idx})">
          <div class="fader-track"></div>
          <div class="fader-cap" id="fader-cap-${idx}" style="top: ${faderDbToPx(ch.fader)}px"></div>
        </div>
      </div>

      <div class="fader-readout" id="fader-val-${idx}">${ch.fader <= -90 ? '-inf' : ch.fader.toFixed(1) + ' dB'}</div>
    `;
    container.appendChild(strip);
  });

  // Master Strip
  const mStrip = document.createElement('div');
  mStrip.className = 'channel-strip master-strip';
  mStrip.innerHTML = `
    <div class="ch-header">BUS ${state.active_bus + 1}</div>
    <div class="ch-sub">MASTER OUT</div>
    <div style="height: 60px;"></div>
    <div class="mute-solo-row">
      <button class="mute-btn ${state.master_mute ? 'active' : ''}" onclick="toggleMasterMute()">MUTE</button>
    </div>
    <div class="fader-meter-row">
      <canvas class="meter-canvas" id="meter-master" width="14" height="210"></canvas>
      <div class="fader-slot" onmousedown="startMasterFaderDrag(event)">
        <div class="fader-track"></div>
        <div class="fader-cap" id="fader-cap-master" style="top: ${faderDbToPx(state.master_volume)}px"></div>
      </div>
    </div>
    <div class="fader-readout" id="fader-val-master">${state.master_volume.toFixed(1)} dB</div>
  `;
  container.appendChild(mStrip);
}

function faderDbToPx(db) {
  // 0 dB is at 50px, +6 dB at 0px, -48 dB at 170px, -inf at 180px
  if (db <= -90) return 175;
  if (db >= 6) return 0;
  if (db >= 0) return (6 - db) / 6 * 45;
  return 45 + (Math.abs(db) / 48) * 130;
}

function pxToFaderDb(px) {
  if (px >= 170) return -96.0;
  if (px <= 0) return 6.0;
  if (px <= 45) return 6.0 - (px / 45) * 6.0;
  return -((px - 45) / 130 * 48.0);
}

function startFaderDrag(e, chIdx) {
  const slot = e.currentTarget;
  const rect = slot.getBoundingClientRect();
  function onMove(ev) {
    const y = Math.max(0, Math.min(175, ev.clientY - rect.top - 20));
    const db = pxToFaderDb(y);
    state.channels[chIdx].fader = db;
    document.getElementById(`fader-cap-${chIdx}`).style.top = y + 'px';
    document.getElementById(`fader-val-${chIdx}`).textContent = db <= -90 ? '-inf' : db.toFixed(1) + ' dB';
  }
  function onUp() {
    window.removeEventListener('mousemove', onMove);
    window.removeEventListener('mouseup', onUp);
    postParam('/api/mixer/set', { ch: chIdx, param: 'fader', value: state.channels[chIdx].fader });
  }
  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', onUp);
  onMove(e);
}

function startMasterFaderDrag(e) {
  const slot = e.currentTarget;
  const rect = slot.getBoundingClientRect();
  function onMove(ev) {
    const y = Math.max(0, Math.min(175, ev.clientY - rect.top - 20));
    const db = pxToFaderDb(y);
    state.master_volume = db;
    document.getElementById('fader-cap-master').style.top = y + 'px';
    document.getElementById('fader-val-master').textContent = db <= -90 ? '-inf' : db.toFixed(1) + ' dB';
  }
  function onUp() {
    window.removeEventListener('mousemove', onMove);
    window.removeEventListener('mouseup', onUp);
    postParam('/api/mixer/master', { volume: state.master_volume });
  }
  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseup', onUp);
  onMove(e);
}

function toggleChParam(chIdx, param) {
  state.channels[chIdx][param] = !state.channels[chIdx][param];
  renderMixer();
  postParam('/api/mixer/set', { ch: chIdx, param: param, value: state.channels[chIdx][param] });
}

function toggleMasterMute() {
  state.master_mute = !state.master_mute;
  renderMixer();
  postParam('/api/mixer/master', { mute: state.master_mute });
}

async function postParam(url, data) {
  try {
    await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
  } catch (e) {
    console.error("POST error:", e);
  }
}

/* Meter Render Engine (60 fps) */
function updateMeters() {
  if (!state.channels) return;
  state.channels.forEach((ch, idx) => {
    const canvas = document.getElementById(`meter-${idx}`);
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const h = canvas.height;
    const w = canvas.width;
    ctx.clearRect(0, 0, w, h);

    // Realistic bouncing levels
    let l_db = ch.peak_l || -48;
    let norm = Math.max(0, Math.min(1, (l_db + 48) / 54));
    let barH = norm * h;

    // 20-segment LED
    const segs = 20;
    const segH = (h / segs) - 2;
    for (let s = 0; s < segs; s++) {
      let sy = h - (s + 1) * (segH + 2);
      let active = (s / segs) <= norm;
      if (active) {
        if (s > 17) ctx.fillStyle = '#ff1744'; // Red
        else if (s > 12) ctx.fillStyle = '#ffea00'; // Yellow
        else ctx.fillStyle = '#00e676'; // Green
      } else {
        ctx.fillStyle = '#181a1f';
      }
      ctx.fillRect(2, sy, w - 4, segH);
    }
  });

  // Master meter
  const mCanvas = document.getElementById('meter-master');
  if (mCanvas) {
    const ctx = mCanvas.getContext('2d');
    ctx.clearRect(0, 0, mCanvas.width, mCanvas.height);
    let norm = 0.65 + 0.2 * Math.sin(Date.now() / 200);
    const segs = 20;
    const segH = (mCanvas.height / segs) - 2;
    for (let s = 0; s < segs; s++) {
      let sy = mCanvas.height - (s + 1) * (segH + 2);
      ctx.fillStyle = (s / segs <= norm) ? (s > 17 ? '#ff1744' : (s > 12 ? '#ffea00' : '#00e676')) : '#181a1f';
      ctx.fillRect(2, sy, mCanvas.width - 4, segH);
    }
  }
}

/* EQ Canvas Rendering */
function renderEQCanvas() {
  const canvas = document.getElementById('eq-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const w = canvas.width;
  const h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  // Grid
  ctx.strokeStyle = '#23252c';
  ctx.lineWidth = 1;
  const freqs = [50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000];
  freqs.forEach(f => {
    let x = (Math.log10(f / 20) / Math.log10(20000 / 20)) * w;
    ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, h); ctx.stroke();
  });
  ctx.beginPath(); ctx.moveTo(0, h/2); ctx.lineTo(w, h/2); ctx.stroke(); // 0 dB line

  // Draw response curve
  ctx.strokeStyle = '#00d2ff';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  for (let px = 0; px < w; px += 2) {
    let f = 20 * Math.pow(20000/20, px / w);
    let totalGain = 0;
    if (state.dsp && state.dsp.eq) {
      state.dsp.eq.forEach(b => {
        if (!b.enabled) return;
        let diff = Math.log2(f / b.freq);
        let g = b.gain / (1 + Math.pow(diff * (b.q || 1), 2));
        totalGain += g;
      });
    }
    let py = (h / 2) - (totalGain / 18) * (h / 2);
    if (px === 0) ctx.moveTo(px, py);
    else ctx.lineTo(px, py);
  }
  ctx.stroke();

  // Nodes
  if (state.dsp && state.dsp.eq) {
    state.dsp.eq.forEach((b, idx) => {
      let x = (Math.log10(b.freq / 20) / Math.log10(20000 / 20)) * w;
      let y = (h / 2) - (b.gain / 18) * (h / 2);
      ctx.fillStyle = '#ffc107';
      ctx.beginPath(); ctx.arc(x, y, 6, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5; ctx.stroke();
    });
  }
}

