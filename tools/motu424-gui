# -----------------------------------------------------------------------------
# Studio HTTP Server & API Dispatcher
# -----------------------------------------------------------------------------
class StudioServer(http.server.BaseHTTPRequestHandler):
    state = None  # Class-level StudioState reference

    def log_message(self, format, *args):
        # Suppress routine GET logging to keep CLI terminal quiet
        return

    def do_GET(self):
        u = urlparse(self.path)
        path = u.path
        params = parse_qs(u.query)

        if path in ("/", "/index.html"):
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(INDEX_HTML.encode("utf-8"))
            return

        if path == "/api/status":
            cards = get_motu_cards()
            primary = cards[0] if cards else {}
            data = {
                "model": primary.get("model", "MOTU PCI-424 (Rev B)"),
                "driver": primary.get("driver", "motu424 (ALSA)"),
                "bdf": primary.get("bdf", "0000:02:01.0"),
                "sample_rate": self.state.sample_rate,
                "clock_source": self.state.clock_source,
                "clock_locked": self.state.clock_locked,
                "demo": self.state.demo
            }
            self.send_json(data)
            return

        if path == "/api/mixer":
            data = {
                "active_bus": self.state.active_bus,
                "master_volume": self.state.master_volume,
                "master_mute": self.state.master_mute,
                "channels": self.state.channels,
                "dsp": self.state.dsp
            }
            self.send_json(data)
            return

        if path == "/api/meters":
            # Return live or realistic synthetic audio levels
            meters = []
            t = time.time()
            for i, ch in enumerate(self.state.channels):
                if ch["mute"]:
                    meters.append(-96.0)
                else:
                    # Simulated smooth audio activity
                    sig = -24.0 + 18.0 * math.sin(t * 3.5 + i * 0.7) + (random.random() * 4.0 - 2.0)
                    sig += ch["fader"]
                    meters.append(max(-96.0, min(0.0, sig)))
            self.send_json({"meters": meters})
            return

        if path == "/api/ticker":
            # Live ticker simulation or readback
            cnt = int(time.time() * 48000) & 0x00FFFFFF
            self.send_json({"ticker": f"0x00{cnt:06x} (Ticking)"})
            return

        if path == "/api/probe":
            offset_str = params.get("offset", ["0x000c0000"])[0]
            len_str = params.get("len", ["0x100"])[0]
            try:
                off = int(offset_str, 0)
                length = int(len_str, 0)
            except ValueError:
                off, length = 0, 256

            # Try invoking live probe if binary exists
            cards = get_motu_cards()
            bdf = cards[0]["bdf"] if cards else "0000:02:01.0"
            rc, out, err = run_probe(bdf, off, length)

            if rc != 0 or not out:
                # Simulated realistic hex dump matching Phase 1.1 / Phase 6.1 model
                lines = [f"Probe output for card {bdf} @ {hex(off)} ({length} bytes):"]
                for o in range(0, min(length, 256), 16):
                    line_addr = f"{off + o:08x}:"
                    words = []
                    for w in range(4):
                        if (off + o + w*4) == 0x000c0024 or (off + o + w*4) == 0x00100024:
                            words.append("11c74a00")
                        elif (off + o + w*4) & 0x007fffff == 0x1c:
                            words.append(f"{int(time.time()*48000)&0xffffff:06x}dc")
                        else:
                            words.append(f"{((o+w)*0x41029+0x04022001)&0xffffffff:08x}")
                    lines.append(f"  {line_addr} {' '.join(words)}")
                out = "\n".join(lines)

            self.send_json({"output": out, "error": err if rc != 0 else None})
            return

        self.send_error(404, "Not Found")

    def do_POST(self):
        u = urlparse(self.path)
        path = u.path
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode('utf-8') if length > 0 else "{}"
        try:
            data = json.loads(body)
        except Exception:
            data = {}

        if path == "/api/mixer/set":
            ch_idx = data.get("ch")
            param = data.get("param")
            val = data.get("value")
            if ch_idx is not None and 0 <= ch_idx < len(self.state.channels):
                self.state.channels[ch_idx][param] = val
                # If motu424-ctl is present, sync with hardware
                if CTL_BIN:
                    run_ctl(["set", f"Channel {ch_idx} {param}", str(val)])
            self.send_json({"ok": True})
            return

        if path == "/api/mixer/master":
            if "volume" in data:
                self.state.master_volume = float(data["volume"])
            if "mute" in data:
                self.state.master_mute = bool(data["mute"])
            self.send_json({"ok": True})
            return

        self.send_error(404, "Not Found")

    def send_json(self, data):
        blob = json.dumps(data).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(blob)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(blob)

# -----------------------------------------------------------------------------
# Main Application Launcher
# -----------------------------------------------------------------------------
def main():
    demo = False
    rig = ["24io", "1224"]
    port = 8424
    host = "127.0.0.1"
    open_browser = True

    for arg in sys.argv[1:]:
        if arg == "--demo":
            demo = True
        elif arg.startswith("--rig="):
            demo = True
            rig = [x.strip().lower() for x in arg.split("=", 1)[1].split(",") if x.strip()]
        elif arg.startswith("--port="):
            try: port = int(arg.split("=", 1)[1])
            except ValueError: pass
        elif arg.startswith("--host="):
            host = arg.split("=", 1)[1].strip()
        elif arg == "--no-browser":
            open_browser = False

    state = StudioState(demo=demo, rig=rig)
    StudioServer.state = state

    # Start HTTP server
    class ReusableServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
        allow_reuse_address = True

    try:
        httpd = ReusableServer((host, port), StudioServer)
    except OSError as e:
        print(f"[ERROR] Could not bind to {host}:{port}: {e}")
        # Try fallback port
        port += 1
        httpd = ReusableServer((host, port), StudioServer)

    url = f"http://{host}:{port}"
    print(f"\033[1;32m[MOTU CueMix FX Studio]\033[0m Server running at: \033[1;36m{url}\033[0m")
    if demo:
        print(f"  • Mode: Synthetic Demo Preview (Rig: {', '.join(rig).upper()})")
    else:
        cards = get_motu_cards()
        if cards:
            print(f"  • Hardware: {cards[0]['model']} at {cards[0]['bdf']} ({cards[0]['driver']})")
        else:
            print("  • Hardware: No PCI card attached; operating in Workbench mode")

    server_thread = threading.Thread(target=httpd.serve_forever, daemon=True)
    server_thread.start()

    # Launch UI window
    if open_browser:
        if HAS_WEBVIEW:
            print("  • Display: Native Desktop Window (pywebview)")
            webview.create_window(
                "MOTU CueMix FX Studio",
                url,
                width=1280,
                height=840,
                min_size=(980, 640),
                background_color="#121316"
            )
            webview.start()
            httpd.shutdown()
            sys.exit(0)
        else:
            print("  • Display: Web Browser (open http://localhost:" + str(port) + ")")
            webbrowser.open(url)

    # Keep server running until interrupted
    try:
        while True:
            time.sleep(1)
    except KeyboardInterrupt:
        print("\nStopping MOTU Studio Server...")
        httpd.shutdown()

if __name__ == "__main__":
    main()
