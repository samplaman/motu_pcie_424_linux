class StudioState:
    def __init__(self, demo=False, rig=None):
        self.demo = demo
        self.rig_models = rig or ["24io", "1224"]
        self.sample_rate = 48000
        self.clock_source = "Internal"
        self.clock_locked = True
        self.active_bus = 0  # 0..7 (Busses 1..8)
        self.master_volume = 0.0  # dB (-inf .. +6)
        self.master_mute = False
        self.talkback = False
        self.listenback = False
        self.channels = []
        self.patchbay = {}
        self.dsp = {
            "eq": [
                {"id": 0, "type": "hpf", "freq": 40, "gain": 0.0, "q": 0.707, "enabled": True},
                {"id": 1, "type": "low_shelf", "freq": 120, "gain": 2.5, "q": 0.707, "enabled": True},
                {"id": 2, "type": "peak", "freq": 450, "gain": -1.5, "q": 1.4, "enabled": True},
                {"id": 3, "type": "peak", "freq": 1800, "gain": 3.0, "q": 1.8, "enabled": True},
                {"id": 4, "type": "peak", "freq": 4200, "gain": -2.0, "q": 2.0, "enabled": True},
                {"id": 5, "type": "high_shelf", "freq": 10000, "gain": 1.5, "q": 0.707, "enabled": True},
                {"id": 6, "type": "lpf", "freq": 18000, "gain": 0.0, "q": 0.707, "enabled": True},
            ],
            "dynamics": {
                "threshold": -20.0,
                "ratio": 4.0,
                "knee": 6.0,
                "attack": 15.0,
                "release": 150.0,
                "makeup": 3.5,
                "enabled": True
            },
            "reverb": {
                "enabled": False,
                "time": 2.2,
                "predelay": 25.0,
                "damp": 45.0,
                "room": "Large Hall"
            }
        }
        self.probe_history = []
        self.init_channels()

    def init_channels(self):
        self.channels = []
        ch_idx = 0
        slot_letters = ["A", "B", "C", "D"]
        for slot_idx, model in enumerate(self.rig_models[:4]):
            slot = slot_letters[slot_idx]
            if model == "24io":
                for i in range(24):
                    self.channels.append(self._make_channel(ch_idx, f"In {ch_idx+1:02d}", slot, "Analog", i, "24I/O"))
                    ch_idx += 1
            elif model == "1224":
                for i in range(8):
                    self.channels.append(self._make_channel(ch_idx, f"In {ch_idx+1:02d}", slot, "Analog", i, "1224"))
                    ch_idx += 1
                for i in range(2):
                    self.channels.append(self._make_channel(ch_idx, f"AES {i+1}", slot, "AES", i, "1224"))
                    ch_idx += 1
            elif model == "2408":
                for i in range(8):
                    self.channels.append(self._make_channel(ch_idx, f"Ana {i+1}", slot, "Analog", i, "2408"))
                    ch_idx += 1
                for i in range(8):
                    self.channels.append(self._make_channel(ch_idx, f"ADAT {i+1}", slot, "ADAT", i, "2408"))
                    ch_idx += 1
                for i in range(2):
                    self.channels.append(self._make_channel(ch_idx, f"SPDIF {i+1}", slot, "SPDIF", i, "2408"))
                    ch_idx += 1
            elif model == "hd192":
                for i in range(12):
                    self.channels.append(self._make_channel(ch_idx, f"In {ch_idx+1:02d}", slot, "Analog", i, "HD192"))
                    ch_idx += 1
        if not self.channels:
            for i in range(24):
                self.channels.append(self._make_channel(i, f"In {i+1:02d}", "A", "Analog", i, "24I/O"))

        # Default patchbay: 1-to-1 normalled
        for ch in self.channels[:24]:
            self.patchbay[ch["name"]] = "Direct"

    def _make_channel(self, uid, name, slot, bank, sub_idx, iface):
        return {
            "id": uid,
            "name": name,
            "slot": slot,
            "bank": bank,
            "sub_idx": sub_idx,
            "interface": iface,
            "trim": 0.0,
            "pad": False,
            "phase": False,
            "stereo": False,
            "fader": -6.0 if uid < 4 else -12.0 if uid < 12 else -inf_db(),
            "pan": 0,
            "mute": False,
            "solo": False,
            "peak_l": -48.0,
            "peak_r": -48.0,
            "clip": False
        }

def inf_db():
    return -96.0

