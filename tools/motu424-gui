HERE = os.path.dirname(os.path.abspath(__file__))

def find_binary(name):
    candidates = [
        os.path.join(HERE, name),
        os.path.join(HERE, "tools", name),
        os.path.join(os.path.dirname(HERE), "tools", name),
        shutil.which(name)
    ]
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return shutil.which(name)

CTL_BIN = find_binary("motu424-ctl")
PROBE_BIN = find_binary("motu424-probe")

def run_ctl(args, dev=None):
    if not CTL_BIN:
        return 127, "", "motu424-ctl not found in tools or PATH"
    cmd = [CTL_BIN] + (["-D", dev] if dev else []) + args
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)

def run_probe(bdf=None, offset=None, length=None):
    if not PROBE_BIN:
        return 127, "", "motu424-probe not found in tools or PATH"
    cmd = [PROBE_BIN]
    if bdf:
        cmd.append(bdf)
    if offset is not None:
        cmd.append(hex(offset) if isinstance(offset, int) else str(offset))
    if length is not None:
        cmd.append(hex(length) if isinstance(length, int) else str(length))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
        return p.returncode, p.stdout, p.stderr
    except Exception as e:
        return 1, "", str(e)

def get_motu_cards():
    cards = []
    base = "/sys/bus/pci/devices"
    models = {
        "0x0003": "MOTU PCI-324",
        "0x0004": "MOTU PCI-424",
        "0x0005": "MOTU PCIe-424 (HD Express)"
    }
    if not os.path.isdir(base):
        return cards
    for d in sorted(os.listdir(base)):
        p = os.path.join(base, d)
        def rd(attr):
            try:
                with open(os.path.join(p, attr)) as f:
                    return f.read().strip()
            except OSError:
                return "?"
        vendor = rd("vendor").lower()
        if vendor != MOTU_VENDOR:
            continue
        dev_id = rd("device").lower()
        drv_path = os.path.join(p, "driver")
        drv = os.path.basename(os.readlink(drv_path)) if os.path.islink(drv_path) else "unbound"
        cards.append({
            "bdf": d,
            "device_id": dev_id,
            "model": models.get(dev_id, f"MOTU (device {dev_id})"),
            "driver": drv,
            "irq": rd("irq"),
            "subsystem_device": rd("subsystem_device")
        })
    return cards

def get_alsa_cards():
    cards = []
    path = "/proc/asound/cards"
    if not os.path.isfile(path):
        return cards
    try:
        with open(path) as f:
            content = f.read()
        for m in re.finditer(r"^\s*(\d+)\s+\[([^\]]+)\]:\s+(.+)$", content, re.M):
            cards.append({
                "number": int(m.group(1)),
                "id": m.group(2).strip(),
                "name": m.group(3).strip()
            })
    except Exception:
        pass
    return cards

