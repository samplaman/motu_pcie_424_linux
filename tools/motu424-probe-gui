def get_demo_memory(bar_idx: int, offset: int, length: int) -> bytes:
    """Produces realistic simulated MOTU register and memory bytes."""
    buf = bytearray(length)

    if bar_idx == 1:  # Window B (4 MB)
        # Bank 0 Base @ 0x000C0000
        bank0 = 0x000C0000
        if offset <= bank0 + 0x40 and offset + length > bank0:
            for rel in range(0, 0x40, 4):
                addr = bank0 + rel
                if offset <= addr < offset + length:
                    val = 0x00000040 if rel == 0x24 else (0x00000001 if rel == 0x00 else 0x00000000)
                    chunk = struct.pack("<I", val)
                    pos = addr - offset
                    buf[pos : pos + 4] = chunk

        # Bank 1 Base @ 0x00100000
        bank1 = 0x00100000
        if offset <= bank1 + 0x40 and offset + length > bank1:
            for rel in range(0, 0x40, 4):
                addr = bank1 + rel
                if offset <= addr < offset + length:
                    val = 0x00000040 if rel == 0x24 else (0x00000001 if rel == 0x00 else 0x00000000)
                    chunk = struct.pack("<I", val)
                    pos = addr - offset
                    buf[pos : pos + 4] = chunk

        # Audio aperture head (simulated sample counter / clock heartbeat)
        if offset < 0x80:
            now_ticks = int(time.time() * 44100) & 0xFFFFFFFF
            struct.pack_into("<I", buf, max(0, 0x2C - offset), now_ticks)

    elif bar_idx == 2:  # I/O Port bridge (256 bytes)
        if offset <= 0x00 < offset + length:
            buf[0x00 - offset] = 0x02  # bit 1 set = ready/pending
        if offset <= 0x04 < offset + length:
            buf[0x04 - offset] = 0x01  # strobe flag

    elif bar_idx == 0:  # Window A (8 MB)
        # FPGA header signature
        sig = b"MOTU-PCI424-FPGA-IMAGE-A"
        for i, b in enumerate(sig):
            if offset <= i < offset + length:
                buf[i - offset] = b

    return bytes(buf)


def read_bar_memory(bdf: str, bar_idx: int, offset: int, length: int, is_demo: bool = False) -> Tuple[bool, bytes, str]:
    """Reads raw bytes from /sys/bus/pci/devices/<bdf>/resource<bar_idx>."""
    if is_demo:
        return True, get_demo_memory(bar_idx, offset, length), ""

    res_path = os.path.join(SYS_PCI, bdf, f"resource{bar_idx}")
    if not os.path.exists(res_path):
        return False, b"", f"PCI resource file not found: {res_path}"

    try:
        # Check file size if available
        file_size = os.path.getsize(res_path)
        if file_size > 0 and offset >= file_size:
            return False, b"", f"Offset 0x{offset:X} exceeds BAR size (0x{file_size:X})"

        with open(res_path, "rb") as f:
            try:
                page_size = os.sysconf("SC_PAGE_SIZE")
            except Exception:
                page_size = 4096

            page_offset = offset & ~(page_size - 1)
            offset_in_page = offset - page_offset
            map_len = ((length + offset_in_page + page_size - 1) // page_size) * page_size

            # Attempt mmap
            try:
                mm = mmap.mmap(f.fileno(), map_len, mmap.MAP_SHARED, mmap.PROT_READ, offset=page_offset)
                data = mm[offset_in_page : offset_in_page + length]
                mm.close()
                return True, data, ""
            except Exception:
                # Direct seek fallback
                f.seek(offset)
                data = f.read(length)
                return True, data, ""

    except PermissionError:
        return False, b"", (
            "Permission denied: Root access is required to read physical PCI MMIO resources.\n"
            "Launch with 'sudo ./tools/motu424-probe-gui' or use pkexec."
        )
    except Exception as e:
        return False, b"", str(e)


# -----------------------------------------------------------------------------
# Formatting Helpers
# -----------------------------------------------------------------------------
def format_hexdump(data: bytes, base_addr: int = 0, baseline: Optional[bytes] = None) -> Tuple[str, List[Tuple[int, int]]]:
    """
    Format binary data into a canonical 16-byte hex dump with ASCII sidebar.
    Returns: (text, list_of_diff_char_ranges)
    """
    lines = []
    diff_ranges = []
    char_pos = 0

    for i in range(0, len(data), 16):
        chunk = data[i : i + 16]
        base_chunk = baseline[i : i + 16] if baseline and i < len(baseline) else None

        addr_str = f"{base_addr + i:08X}:  "
        hex_tokens = []
        ascii_chars = []

        for b_idx in range(16):
            if b_idx == 8:
                hex_tokens.append(" ")

            if b_idx < len(chunk):
                b = chunk[b_idx]
                token = f"{b:02X}"
                hex_tokens.append(token)
                ascii_chars.append(chr(b) if 32 <= b < 127 else ".")
            else:
                hex_tokens.append("  ")
                ascii_chars.append(" ")

        line_str = addr_str + " ".join(hex_tokens[:8]) + "  " + " ".join(hex_tokens[8:]) + "  |" + "".join(ascii_chars) + "|\n"
        lines.append(line_str)

    return "".join(lines), diff_ranges


def format_c_array(data: bytes, var_name: str = "motu_probe_dump") -> str:
    """Format data into a C byte array declaration."""
    lines = [f"/* MOTU PCI-424 Register Dump ({len(data)} bytes) */", f"static const uint8_t {var_name}[{len(data)}] = {{"]
    for i in range(0, len(data), 12):
        chunk = data[i : i + 12]
        hex_vals = ", ".join(f"0x{b:02X}" for b in chunk)
        lines.append(f"    {hex_vals},")
    lines.append("};")
    return "\n".join(lines)


def human_size(bytes_val: int) -> str:
    """Format byte size into human readable string."""
    if bytes_val <= 0:
        return "0 B"
    if bytes_val >= 1024 * 1024:
        return f"{bytes_val / (1024 * 1024):.1f} MB"
    if bytes_val >= 1024:
        return f"{bytes_val / 1024:.1f} KB"
    return f"{bytes_val} B"


