    # -------------------------------------------------------------------------
    # Card Selection & Scanning
    # -------------------------------------------------------------------------
    def rescan_devices(self):
        """Scans the PCI bus and populates the device list."""
        if self.is_demo_mode:
            self.cards = [create_demo_card()]
        else:
            show_all = self.chk_all_pci.get_active() if hasattr(self, "chk_all_pci") else False
            include_all = bool(self.target_bdf) or show_all
            self.cards = scan_pci_devices(include_all=include_all)
            if not self.cards:
                # If no physical MOTU card found, offer demo card so GUI is interactive
                self.cards = [create_demo_card()]
                self.lbl_status.set_text("No physical MOTU card found on PCI bus. Loaded simulated PCIe-424 card.")
            else:
                motu_cnt = sum(1 for c in self.cards if c.get("is_motu"))
                if show_all or self.target_bdf:
                    self.lbl_status.set_text(f"Found {len(self.cards)} PCI device(s) ({motu_cnt} MOTU).")
                else:
                    self.lbl_status.set_text(f"Found {len(self.cards)} MOTU device(s).")

        # Update card dropdown
        labels = [f"{c['name']} [{c['bdf']}]" for c in self.cards]
        self.dropdown_card.set_model(Gtk.StringList.new(labels))

        # Auto-select matching target_bdf or first card
        target_idx = 0
        if self.target_bdf:
            for idx, c in enumerate(self.cards):
                if self.target_bdf in c["bdf"]:
                    target_idx = idx
                    break

        self.dropdown_card.set_selected(target_idx)
        self._update_card_ui(self.cards[target_idx])

    def _on_card_selected(self, dropdown, _param):
        idx = dropdown.get_selected()
        if 0 <= idx < len(self.cards):
            self._update_card_ui(self.cards[idx])

    def _on_demo_toggled(self, switch, _param):
        self.is_demo_mode = switch.get_active()
        self.rescan_devices()

    def _update_card_ui(self, card: Dict[str, Any]):
        self.selected_card = card

        # Update Banner
        self.lbl_dev_name.set_text(card["name"])
        details = (
            f"BDF: {card['bdf']}   |   "
            f"PCI ID: {card['vendor']:04X}:{card['device']:04X}   |   "
            f"Sub: {card['sub_vendor']:04X}:{card['sub_device']:04X}   |   "
            f"IRQ: {card['irq']}"
        )
        self.lbl_dev_details.set_text(details)

        # Update Driver Status
        driver = card.get("driver")
        self.driver_banner.remove_css_class("status-warning")
        self.driver_banner.remove_css_class("status-ok")

        if driver == "motu424":
            self.lbl_driver_status.set_text("⚠️ Kernel driver 'motu424' is active. Unbind driver before raw register probing.")
            self.driver_banner.add_css_class("status-warning")
            self.btn_unbind.set_visible(True)
            self.btn_bind.set_visible(False)
        elif driver:
            self.lbl_driver_status.set_text(f"⚠️ Driver '{driver}' is bound to this device.")
            self.driver_banner.add_css_class("status-warning")
            self.btn_unbind.set_visible(True)
            self.btn_bind.set_visible(False)
        else:
            self.lbl_driver_status.set_text("✓ Driver unbound. Card is ready for direct register and memory access.")
            self.driver_banner.add_css_class("status-ok")
            self.btn_unbind.set_visible(False)
            self.btn_bind.set_visible(True)

        # Populate BARs List
        self._populate_bars_tab(card["bars"])

    def _populate_bars_tab(self, bars: List[Dict[str, Any]]):
        # Clear existing
        while child := self.box_bars_list.get_first_child():
            self.box_bars_list.remove(child)

        for bar in bars:
            card_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            card_row.add_css_class("bar-card")

            # Header row
            top_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            card_row.append(top_row)

            lbl_bar_name = Gtk.Label(label=f"BAR {bar['index']}")
            lbl_bar_name.add_css_class("monospace")
            top_row.append(lbl_bar_name)

            lbl_badge = Gtk.Label(label=bar["category"])
            lbl_badge.add_css_class("badge")
            lbl_badge.add_css_class(bar["color_class"])
            top_row.append(lbl_badge)

            lbl_size = Gtk.Label(label=f"Size: {human_size(bar['size'])}")
            lbl_size.add_css_class("caption")
            lbl_size.set_xalign(0.0)
            lbl_size.set_hexpand(True)
            top_row.append(lbl_size)

            if bar["size"] > 0:
                btn_inspect = Gtk.Button(label="Inspect Memory →")
                btn_inspect.set_valign(Gtk.Align.CENTER)
                btn_inspect.connect("clicked", lambda _, idx=bar["index"]: self._inspect_bar(idx))
                top_row.append(btn_inspect)

            # Detail row
            if bar["size"] > 0:
                det_str = f"Address Range: 0x{bar['start']:08X} .. 0x{bar['end']:08X}   |   Flags: 0x{bar['flags']:08X}"
                lbl_addr = Gtk.Label(label=det_str)
                lbl_addr.set_xalign(0.0)
                lbl_addr.add_css_class("monospace")
                lbl_addr.add_css_class("caption")
                card_row.append(lbl_addr)

            lbl_role = Gtk.Label(label=bar["role"])
            lbl_role.set_xalign(0.0)
            lbl_role.set_wrap(True)
            card_row.append(lbl_role)

            self.box_bars_list.append(card_row)

    def _inspect_bar(self, bar_idx: int):
        self.dd_bar.set_selected(bar_idx)
        self.entry_offset.set_text("0x00000000")
        self.entry_len.set_text("0x100")
        self.notebook.set_current_page(1)  # Switch to Hex Dump Tab
        self.dump_memory()

    def _apply_preset(self, bar_idx: int, offset: int, length: int):
        self.dd_bar.set_selected(bar_idx)
        self.entry_offset.set_text(f"0x{offset:08X}")
        self.entry_len.set_text(f"0x{length:X}")
        self.dump_memory()

    # -------------------------------------------------------------------------
    # Driver Unbind / Bind
    # -------------------------------------------------------------------------
    def _on_unbind_clicked(self, _):
        if not self.selected_card:
            return
        bdf = self.selected_card["bdf"]
        if self.selected_card.get("is_demo"):
            self.selected_card["driver"] = None
            self._update_card_ui(self.selected_card)
            self.lbl_status.set_text("Simulated driver unbound.")
            return

        cmd = ["pkexec", "sh", "-c", f"echo '{bdf}' > /sys/bus/pci/drivers/motu424/unbind"]
        try:
            subprocess.run(cmd, check=True)
            self.lbl_status.set_text(f"Unbound driver from {bdf}")
            self.rescan_devices()
        except Exception as e:
            self.lbl_status.set_text(f"Failed to unbind: {e}")

    def _on_bind_clicked(self, _):
        if not self.selected_card:
            return
        bdf = self.selected_card["bdf"]
        if self.selected_card.get("is_demo"):
            self.selected_card["driver"] = "motu424"
            self._update_card_ui(self.selected_card)
            self.lbl_status.set_text("Simulated driver bound.")
            return

        cmd = ["pkexec", "sh", "-c", f"echo '{bdf}' > /sys/bus/pci/drivers/motu424/bind"]
        try:
            subprocess.run(cmd, check=True)
            self.lbl_status.set_text(f"Bound driver to {bdf}")
            self.rescan_devices()
        except Exception as e:
            self.lbl_status.set_text(f"Failed to bind: {e}")

    # -------------------------------------------------------------------------
    # Memory Hex Dump Operations
    # -------------------------------------------------------------------------
    def dump_memory(self):
        if not self.selected_card:
            self.lbl_status.set_text("No card selected.")
            return

        bar_idx = self.dd_bar.get_selected()
        try:
            raw_off = self.entry_offset.get_text().strip()
            offset = int(raw_off, 16 if raw_off.lower().startswith("0x") else 10)
        except ValueError:
            self.lbl_status.set_text("Invalid offset: enter a hex (0xC0000) or decimal value.")
            return

        try:
            raw_len = self.entry_len.get_text().strip()
            length = int(raw_len, 16 if raw_len.lower().startswith("0x") else 10)
            if length <= 0 or length > 64 * 1024:
                length = 256
        except ValueError:
            length = 256

        bdf = self.selected_card["bdf"]
        is_demo = self.selected_card.get("is_demo", False)

        t0 = time.time()
        ok, data, err = read_bar_memory(bdf, bar_idx, offset, length, is_demo=is_demo)
        elapsed_ms = (time.time() - t0) * 1000.0

        if not ok:
            self.text_hex.get_buffer().set_text(f"Error reading BAR {bar_idx} at offset 0x{offset:X}:\n\n{err}")
            self.lbl_status.set_text(f"Failed to read BAR {bar_idx}: {err}")
            return

        self.last_dump_bytes = data
        dump_str, _ = format_hexdump(data, base_addr=offset, baseline=self.baseline_bytes)

        buf = self.text_hex.get_buffer()
        buf.set_text(dump_str)

        card_label = "Window B" if bar_idx == 1 else ("Window A" if bar_idx == 0 else f"BAR {bar_idx}")
        self.lbl_status.set_text(
            f"Read {len(data)} bytes from {card_label} @ 0x{offset:08X} in {elapsed_ms:.2f} ms"
        )

    def _on_set_baseline(self, _):
        if self.last_dump_bytes:
            self.baseline_bytes = self.last_dump_bytes
            self.lbl_baseline_info.set_text(f"Baseline: {len(self.baseline_bytes)} bytes stored")
            self.lbl_status.set_text("Baseline captured for diffing.")
        else:
            self.lbl_status.set_text("Dump memory first before setting baseline.")

    def _on_copy_hex(self, _):
        buf = self.text_hex.get_buffer()
        start, end = buf.get_bounds()
        text = buf.get_text(start, end, True)
        if text:
            display = Gdk.Display.get_default()
            if display:
                display.get_clipboard().set(text)
                self.lbl_status.set_text("Hex dump copied to clipboard.")

    def _on_copy_c_array(self, _):
        if not self.last_dump_bytes:
            self.lbl_status.set_text("No dump data available to export.")
            return

        c_code = format_c_array(self.last_dump_bytes)
        display = Gdk.Display.get_default()
        if display:
            display.get_clipboard().set(c_code)
            self.lbl_status.set_text("C array code copied to clipboard.")

    def _on_save_file(self, _):
        buf = self.text_hex.get_buffer()
        start, end = buf.get_bounds()
        text = buf.get_text(start, end, True)
        if not text:
            self.lbl_status.set_text("No dump data to save.")
            return

        default_filename = f"motu_bar_dump_{int(time.time())}.txt"
        dialog = Gtk.FileDialog()
        dialog.set_initial_name(default_filename)

        def on_save_finish(diag, res):
            try:
                gfile = diag.save_finish(res)
                if gfile:
                    path = gfile.get_path()
                    with open(path, "w") as f:
                        f.write(text)
                    self.lbl_status.set_text(f"Saved dump to {path}")
            except Exception as e:
                self.lbl_status.set_text(f"Save canceled or failed: {e}")

        dialog.save(self, None, on_save_finish)


