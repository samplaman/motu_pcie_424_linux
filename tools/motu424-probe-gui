class ProbeWindow(Gtk.ApplicationWindow):
    def __init__(self, app: Gtk.Application, initial_demo: bool = False, target_bdf: Optional[str] = None):
        super().__init__(application=app)
        self.set_title("MOTU PCI / PCIe Card Probe")
        self.set_default_size(1050, 750)

        self.cards: List[Dict[str, Any]] = []
        self.selected_card: Optional[Dict[str, Any]] = None
        self.is_demo_mode = initial_demo
        self.target_bdf = target_bdf

        self.last_dump_bytes: Optional[bytes] = None
        self.baseline_bytes: Optional[bytes] = None

        self._build_ui()
        self.rescan_devices()

    def _build_ui(self):
        # Apply CSS
        provider = Gtk.CssProvider()
        provider.load_from_data(MODERN_CSS)
        display = Gdk.Display.get_default()
        if display:
            Gtk.StyleContext.add_provider_for_display(
                display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        # Header Bar
        hb = Gtk.HeaderBar()
        self.set_titlebar(hb)

        lbl_title = Gtk.Label(label="MOTU Card Probe")
        lbl_title.add_css_class("title")
        hb.set_title_widget(lbl_title)

        # Card Selector Dropdown
        self.dropdown_card = Gtk.DropDown.new_from_strings(["Scanning..."])
        self.dropdown_card.set_valign(Gtk.Align.CENTER)
        self.dropdown_card.connect("notify::selected", self._on_card_selected)
        hb.pack_start(self.dropdown_card)

        # Rescan Button
        btn_rescan = Gtk.Button(label="Rescan")
        btn_rescan.set_tooltip_text("Rescan PCI bus for MOTU audio hardware")
        btn_rescan.set_valign(Gtk.Align.CENTER)
        btn_rescan.connect("clicked", lambda _: self.rescan_devices())
        hb.pack_start(btn_rescan)

        # All PCI Devices CheckButton
        self.chk_all_pci = Gtk.CheckButton(label="All PCI Devices")
        self.chk_all_pci.set_tooltip_text("List all PCI devices on the system (useful for testing on systems without MOTU card)")
