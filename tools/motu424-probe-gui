def classify_bar(start: int, end: int, flags: int, size: int) -> Tuple[str, str, str]:
    """
    Classify a PCI BAR according to the reverse-engineered MOTU hardware model.
    Returns: (category, color_class, role_description)
    """
    if size == 0 or start == 0:
        return "Unused", "bar-unused", "BAR disabled or unallocated by BIOS/kernel"

    is_io = bool(flags & 0x00000100)
    is_mem = bool(flags & 0x00000200)

    if is_io:
        return (
            "I/O-Port Bridge",
            "bar-port",
            "PLX/FPGA bridge control (+0x0 bit 1: ready/pending, +0x4: strobe kick)",
        )

    if is_mem:
        if size >= 0x800000:  # >= 8 MB
            return (
                "Window A (8 MB MMIO)",
                "bar-wina",
                "Direct FPGA access path (dev-ext +0x7c); used for 8-dword block writes (WriteBlock8)",
            )
        elif size >= 0x200000:  # ~4 MB
            return (
                "Window B (4 MB MMIO)",
                "bar-winb",
                "Audio aperture ring buffer & Bank register space (dev-ext +0x78); gates audio streaming",
            )
        else:
            return (
                "MMIO (Small)",
                "bar-mmio",
                "Small memory-mapped I/O region or configuration aperture",
            )

    return "Unknown", "bar-unknown", f"Raw flags: {hex(flags)}"


def scan_pci_devices(include_all: bool = False) -> List[Dict[str, Any]]:
    """Scan /sys/bus/pci/devices for MOTU audio cards (or all devices)."""
    cards = []
    if not os.path.isdir(SYS_PCI):
        return cards

    for bdf in sorted(os.listdir(SYS_PCI)):
        dev_path = os.path.join(SYS_PCI, bdf)
        if not os.path.isdir(dev_path):
            continue

        vendor = 0
        device = 0
        sub_vendor = 0
        sub_device = 0
        irq = 0
        revision = 0
        driver = None

        try:
            with open(os.path.join(dev_path, "vendor"), "r") as f:
                vendor = int(f.read().strip(), 16)
            with open(os.path.join(dev_path, "device"), "r") as f:
                device = int(f.read().strip(), 16)
        except Exception:
            continue

        is_motu = (vendor == MOTU_VENDOR)
        if not is_motu and not include_all:
            continue

        try:
            with open(os.path.join(dev_path, "subsystem_vendor"), "r") as f:
                sub_vendor = int(f.read().strip(), 16)
            with open(os.path.join(dev_path, "subsystem_device"), "r") as f:
                sub_device = int(f.read().strip(), 16)
        except Exception:
            pass

        try:
            with open(os.path.join(dev_path, "irq"), "r") as f:
                irq = int(f.read().strip(), 10)
        except Exception:
            pass

        try:
            with open(os.path.join(dev_path, "revision"), "r") as f:
                revision = int(f.read().strip(), 16)
        except Exception:
            pass

        drv_link = os.path.join(dev_path, "driver")
        if os.path.islink(drv_link):
            driver = os.path.basename(os.readlink(drv_link))

        bars = []
        res_file = os.path.join(dev_path, "resource")
        if os.path.isfile(res_file):
            try:
                with open(res_file, "r") as f:
                    for idx, line in enumerate(f):
                        if idx >= 6:
                            break
                        parts = line.strip().split()
                        if len(parts) >= 3:
                            start = int(parts[0], 16)
                            end = int(parts[1], 16)
                            flags = int(parts[2], 16)
                            size = (end - start + 1) if start > 0 else 0
                            cat, color_cls, role = classify_bar(start, end, flags, size)
                            bars.append({
                                "index": idx,
                                "start": start,
                                "end": end,
                                "flags": flags,
                                "size": size,
                                "category": cat,
                                "color_class": color_cls,
                                "role": role,
                                "is_io": bool(flags & 0x100),
                            })
            except Exception:
                pass

        # Pad to 6 BARs
        while len(bars) < 6:
            idx = len(bars)
            cat, color_cls, role = classify_bar(0, 0, 0, 0)
            bars.append({
                "index": idx,
                "start": 0,
                "end": 0,
                "flags": 0,
                "size": 0,
                "category": cat,
                "color_class": color_cls,
                "role": role,
                "is_io": False,
            })

        friendly_name = MOTU_CARD_NAMES.get(device, f"PCI Audio ({hex(vendor)}:{hex(device)})")
        cards.append({
            "bdf": bdf,
            "vendor": vendor,
            "device": device,
            "sub_vendor": sub_vendor,
            "sub_device": sub_device,
            "irq": irq,
            "revision": revision,
            "driver": driver,
            "bars": bars,
            "is_motu": is_motu,
            "name": friendly_name,
            "is_demo": False,
        })

    return cards


