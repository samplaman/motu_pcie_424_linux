class ProbeApp(Gtk.Application):
    def __init__(self, demo: bool = False, target_bdf: Optional[str] = None):
        super().__init__(application_id="org.samplaman.motu424.probe_gui")
        self.demo = demo
        self.target_bdf = target_bdf

    def do_activate(self):
        win = ProbeWindow(self, initial_demo=self.demo, target_bdf=self.target_bdf)
        win.present()


def main():
    parser = argparse.ArgumentParser(
        description="MOTU PCI-324 / PCI-424 / PCIe-424 Card Probe & BAR Inspector GUI"
    )
    parser.add_argument(
        "bdf",
        nargs="?",
        default=None,
        help="Target PCI device BDF (e.g. 0000:02:00.0)",
    )
    parser.add_argument(
        "--demo",
        action="store_true",
        help="Run in demonstration mode with simulated PCIe-424 hardware",
    )
    args = parser.parse_args()

    app = ProbeApp(demo=args.demo, target_bdf=args.bdf)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main())
