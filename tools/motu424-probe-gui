        self.chk_all_pci.connect("toggled", lambda _: self.rescan_devices())
        hb.pack_start(self.chk_all_pci)

        # Demo Switch
        box_demo = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box_demo.set_valign(Gtk.Align.CENTER)
        lbl_demo = Gtk.Label(label="Demo Mode")
        lbl_demo.add_css_class("badge")
        lbl_demo.add_css_class("badge-demo")
        self.switch_demo = Gtk.Switch()
        self.switch_demo.set_active(self.is_demo_mode)
        self.switch_demo.connect("notify::active", self._on_demo_toggled)
        box_demo.append(lbl_demo)
        box_demo.append(self.switch_demo)
        hb.pack_end(box_demo)

